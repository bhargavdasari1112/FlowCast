# ==============================================================================
# FlowCast AI — Environment Configuration Template (.env.example)
#
# NOTE: This file contains ONLY non-sensitive template placeholders.
# Copy this file to '.env' and populate with local values if customizing.
# DO NOT commit any actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server Environment Configuration
FLOWCAST_ENV=development
FLOWCAST_HOST=127.0.0.1
FLOWCAST_PORT=8000
FLOWCAST_DEBUG=false
FLOWCAST_WORKERS=1

# Security & CORS Settings
# Comma-separated list of allowed origins
FLOWCAST_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
FLOWCAST_SECRET_KEY=change_me_to_a_random_32_character_hex_key

# External Telemetry & Weather Services (Optional Overrides)
# Open-Meteo public API endpoint (Default: free public tier, no API key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
# Optional external weather provider API key (if using commercial weather services)
WEATHER_API_KEY=YOUR_WEATHER_API_KEY_HERE

# Database / Cache Configuration (Optional — currently operates on high-speed in-memory feature store)
DATABASE_URL=sqlite:///./data/flowcast.db
REDIS_URL=redis://localhost:6379/0

# Model Inference Configuration
MODEL_DIR=./models
DATA_DIR=./data
CACHE_TTL_SECONDS=600

# Logging & Telemetry
LOG_LEVEL=INFO
ENABLE_ACCESS_LOG=true
